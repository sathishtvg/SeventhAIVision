# Template for docker/.env, which is gitignored and therefore does NOT travel
# with a clone. Copy this to docker/.env and fill in every CHANGE_ME before
# the stack will start on a new machine.
#
#   cp docker/.env.example docker/.env
#
# Generate each secret separately — never reuse one value across two keys:
#   openssl rand -base64 32                       # passwords, JWT keys, HMAC key
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                                                 # CREDENTIALS_ENCRYPTION_KEY only (Fernet format)
#
# CREDENTIALS_ENCRYPTION_KEY encrypts stored device and gateway credentials at
# rest. Changing it makes every already-encrypted credential unreadable, so on
# an existing database it has to be rotated with a re-encryption pass, not
# swapped. On a fresh database, generate a new one.
#
# DEVICE selects the inference backend: leave empty to auto-detect (CUDA when
# torch reports it, else CPU), or force "cuda" / "cpu". The GPU compose
# overlay sets it to cuda per worker, so it can stay empty here.

POSTGRES_DB=seventh_ai_vision
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_APP_USER=svc_app
POSTGRES_APP_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY_CURRENT=CHANGE_ME
JWT_SECRET_KEY_PREVIOUS=CHANGE_ME
JWT_ACTIVE_KID=2026-06
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=CHANGE_ME
REFRESH_TOKEN_TTL_DAYS=CHANGE_ME
EVIDENCE_ROOT=/data/evidence
LPR_CONFIDENCE_THRESHOLD=0.55
FACE_MATCH_THRESHOLD=0.6
INTRUSION_BREACH_COOLDOWN_SECONDS=60
EVIDENCE_RETENTION_DAYS=90
AUDIT_RETENTION_YEARS=7
DEVICE=
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
APP_VERSION=0.1.0
GIT_SHA=dev
BUILD_DATE=dev
AUDIT_HMAC_KEY=CHANGE_ME
CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME
