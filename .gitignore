# Secrets — never commit
.env
docker/.env
!.env.example

# Dependencies
node_modules/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.venv-worker/
.pytest_cache/

# Build artifacts
frontend/dist/
desktop/dist/
desktop/release/

# Generated reports / scan output. The directories are tracked (via .gitkeep)
# because test_trivy.py asserts they exist; the reports written into them are
# not. A directory cannot be re-included once its parent is excluded, hence the
# un-exclude / re-exclude pairs rather than a single negation.
reports/*
!reports/.gitkeep
!reports/trivy/
reports/trivy/*
!reports/trivy/.gitkeep

# Leftover nested-repo metadata (moved aside during git init, not source)
mobile/.git.bak-nested-repo/

# Claude Code local-only files (not shared)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# OS / editor cruft
.DS_Store
Thumbs.db
*.log

# Database dumps taken before destructive operations. Local only — these
# can contain production-shaped data and are far too large for the repo.
backups/
