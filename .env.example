# Postgres — POSTGRES_USER is the bootstrap SUPERUSER (migrations only, never used
# by a running service). POSTGRES_APP_USER is the restricted role every service
# actually connects as; RLS only works because this one is NOT a superuser (§2/§16).
POSTGRES_DB=seventh_ai_vision
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_APP_USER=svc_app
POSTGRES_APP_PASSWORD=change_me_dev_only_too

# Redis
REDIS_URL=redis://redis:6379/0

# Auth — JWT_SECRET_KEY_CURRENT is the active signing key (kid=JWT_ACTIVE_KID).
# JWT_SECRET_KEY_PREVIOUS is only set during a rotation window (see plan §16.4).
JWT_SECRET_KEY_CURRENT=change_me_dev_only
JWT_SECRET_KEY_PREVIOUS=
JWT_ACTIVE_KID=2026-06
JWT_PREVIOUS_KID=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Evidence storage
EVIDENCE_ROOT=/data/evidence

# Object storage — set STORAGE_BACKEND=s3 to route evidence through MinIO/S3.
# Leave as "local" to keep Phase-1 behaviour (files on EVIDENCE_ROOT disk).
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PRESIGN_TTL_SECONDS=3600

# WebSocket per-IP connection limit (Task 10)
WS_MAX_CONNECTIONS_PER_IP=10

# AI worker tuning defaults (overridable per-tenant via tenant_settings, see plan §8)
LPR_CONFIDENCE_THRESHOLD=0.55
FACE_MATCH_THRESHOLD=0.6
INTRUSION_BREACH_COOLDOWN_SECONDS=60
EVIDENCE_RETENTION_DAYS=90
AUDIT_RETENTION_YEARS=7

# Device override for ai-worker: "cuda" | "cpu" | unset (auto-detect)
DEVICE=

# Phase 4 — Email notifications (aiosmtplib).  Leave SMTP_HOST blank to disable.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@seventh.ai

# Phase 4 — SMS notifications (Twilio).  Leave blank to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Backup / DR
# Daily pg_dump backups written to the backups_data Docker volume (/data/backups/daily/).
# Scheduler runs one backup per SCHEDULER_INTERVAL_SECONDS cycle (default 24 h).
# Admins can trigger on-demand via POST /api/v1/system/backup.
# To restore: docker exec docker-postgres-1 psql ... < backup_YYYYMMDD_HHMMSS.sql
# (see docs/DR-RUNBOOK.md for full procedure)
BACKUP_KEEP_DAILY=7

# TLS / HTTPS
# The frontend nginx container auto-generates a self-signed cert on first boot
# and stores it in the certs_data Docker volume at /etc/nginx/certs/.
# To use a real certificate (Let's Encrypt / commercial CA), copy your PEM files
# into that volume before starting the container:
#   certs_data volume → /etc/nginx/certs/server.crt  (full-chain PEM)
#   certs_data volume → /etc/nginx/certs/server.key  (private key, unencrypted)
# The ssl-entrypoint.sh script will skip generation when both files are present.
# HTTPS is served on port 443; HTTP on port 5173 redirects to HTTPS.

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Release metadata (plan §16.5)
APP_VERSION=0.1.0
GIT_SHA=dev
BUILD_DATE=dev
